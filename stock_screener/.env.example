MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=market_data

FEISHU_WEBHOOK_URL=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
FEISHU_SEND_RETRY_ATTEMPTS=3
FEISHU_SEND_RETRY_DELAY_SEC=1
FEISHU_DNS_RETRY_ATTEMPTS=6
FEISHU_DNS_RETRY_DELAY_SEC=1

# Set to 1 to avoid AKShare K-line fallback when external DNS/data sources are unstable.
KLINE_DISABLE_AKSHARE=0

# Search + LLM signal analysis
ENABLE_LLM_ANALYSIS=1
TAVILY_API_KEY=
ZHIPUAI_API_KEY=
BIGMODEL_API_KEY=
SIGNAL_SEARCH_PROVIDER_ORDER=tavily,zhipuai
SIGNAL_SEARCH_MAX_RESULTS=5
SIGNAL_SEARCH_TIMEOUT_SEC=30
ZHIPUAI_WEB_SEARCH_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/web_search
ZHIPUAI_WEB_SEARCH_ENGINE=search_std
ZHIPUAI_WEB_SEARCH_CONTENT_SIZE=medium
ZHIPUAI_WEB_SEARCH_RECENCY_FILTER=noLimit

# Market Intel backend data layer.
# API/UI live providers are cache-first. Signal-analysis integration remains opt-in.
MARKET_INTEL_ENABLE_LIVE_PROVIDERS=1
MARKET_INTEL_PROVIDER_TIMEOUT_SEC=10
SIGNAL_ENABLE_MARKET_INTEL=0

# Market Intel source expansion.
# Stable HTTP providers are enabled by default; search-like and browser/cookie providers are opt-in.
MARKET_INTEL_PROVIDER_ORDER=cailianpress,sina,tradingview,eastmoney,global_index
MARKET_INTEL_ENABLE_CAILIANPRESS=1
MARKET_INTEL_ENABLE_SINA=1
MARKET_INTEL_ENABLE_TRADINGVIEW=1
MARKET_INTEL_ENABLE_EASTMONEY=1
MARKET_INTEL_ENABLE_GLOBAL_INDEX=1
MARKET_INTEL_ENABLE_IWENCAI=0
MARKET_INTEL_ENABLE_EASTMONEY_SEARCH=0
MARKET_INTEL_ENABLE_XUEQIU=0
MARKET_INTEL_TRADINGVIEW_DETAIL_LIMIT=5
MARKET_INTEL_BROWSER_PROVIDERS_ALLOWED=0

# Web platform
WEB_SESSION_COOKIE=moneymanager_session
WEB_SESSION_TTL_HOURS=24
WEB_COOKIE_SECURE=1
WEB_BOOTSTRAP_USERNAME=
WEB_BOOTSTRAP_PASSWORD=
ARTIFACT_DIR=/data/moneymanager/artifacts
REDIS_URL=redis://redis:6379/0
AGENT_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

# Cloud K-line policy
KLINE_USE_FUTU_OPEND=0
KLINE_CACHE_MAX_BARS=500

# Local quant backtest. Set to 1 when the backend runs on the same machine as Futu OpenD.
QUANT_ENABLE_FUTU_OPEND=0

# Local Agent
CLOUD_API_BASE=https://your-domain.com
AGENT_MARKETS=HK,US,A
AGENT_TIMEFRAMES=1d,1wk,1mo,3mo,1m,3m,5m,15m,30m,60m
AGENT_API_RETRIES=3
AGENT_BATCH_SIZE=1000
AGENT_MAX_CODES_PER_MARKET=100
AGENT_MAX_KLINE_COUNT=500
AGENT_API_TIMEOUT_SEC=120
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
