{
    default_sni {$DOMAIN_NAME:localhost}
}

{$DOMAIN_NAME:localhost} {
    encode gzip

    tls {
        issuer acme {
            profile shortlived
            disable_tlsalpn_challenge
        }
    }

    handle /api/* {
        reverse_proxy web-api:8000
    }

    handle /healthz {
        reverse_proxy web-api:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}
